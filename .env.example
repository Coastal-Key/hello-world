# Coastal Key Master Orchestrator — Required Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to git.

# === Cloudflare Workers AI ===
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_WORKER_URL=https://coastalkey-master-orchestrator.your-subdomain.workers.dev

# === Anthropic API (Nemotron fallback) ===
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# === Airtable ===
AIRTABLE_API_KEY=patUxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_URL=https://api.airtable.com/v0

# === Slack ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# === Atlas (Outbound Dialing) ===
ATLAS_API_URL=https://api.atlas.your-domain.com
ATLAS_API_KEY=your_atlas_api_key

# === Buffer (Social Publishing) ===
BUFFER_ACCESS_TOKEN=your_buffer_access_token

# === Banana Pro AI (Visual Assets) ===
BANANA_PRO_AI_WEBHOOK=https://api.bananapro.ai/webhook/your-endpoint

# === Nanobanana (AI Bot Interface) ===
NANOBANANA_API_URL=https://nanobanana.your-domain.com
NANOBANANA_API_KEY=your_nanobanana_api_key

# === Constant Contact (Long-Tail Nurture) ===
CONSTANT_CONTACT_API=https://api.cc.email/v3
CONSTANT_CONTACT_TOKEN=your_constant_contact_token

# === AWS S3 (Investor Compliance Archive) ===
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET=coastalkey-investor-compliance

# === Gmail (via Zapier — no direct credentials needed) ===
# Gmail is connected through Zapier OAuth. No env var required.

# === Dashboard (KPI Feed) ===
DASHBOARD_WEBHOOK_URL=https://your-dashboard-provider.com/webhook/feed
